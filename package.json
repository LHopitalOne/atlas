{
  "name": "atlas",
  "version": "1.0.0",
  "description": "Zoomable WebGL2 map of a service graph, built to a single HTML file.",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build.mjs --offline",
    "build:page": "node scripts/build.mjs --offline --graph=scripts/page-slot.txt --out=bridge/atlas_bridge/adapters/page/atlas.html",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=75 --test-coverage-branches=75 --test-coverage-functions=75 test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint src test scripts && prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.mjs\"",
    "lint:imports": "node --test test/architecture.test.js",
    "check": "npm run lint && npm run lint:imports && npm run test:coverage && npm run build && npm run test:e2e",
    "index:self": "tools/index-self/run.sh",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.mjs\""
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sourcegraph/scip-typescript": "^0.5.2",
    "d3-hierarchy": "^3.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "private": true
}
