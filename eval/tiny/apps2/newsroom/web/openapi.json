{
  "openapi": "3.1.0",
  "info": {
    "title": "newsroom api",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/stories/top": {
      "get": {
        "tags": [
          "stories"
        ],
        "summary": "List Top Stories",
        "operationId": "listTopStories",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Story"
                  },
                  "title": "Response Listtopstories"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stories/{story_id}": {
      "get": {
        "tags": [
          "stories"
        ],
        "summary": "Get Story",
        "operationId": "getStory",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Story Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Story"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/summaries": {
      "post": {
        "tags": [
          "summaries"
        ],
        "summary": "Request Summary",
        "operationId": "requestSummary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryJob"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/summaries/{story_id}": {
      "get": {
        "tags": [
          "summaries"
        ],
        "summary": "Get Summary",
        "operationId": "getSummary",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Story Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Story": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "By"
          },
          "score": {
            "type": "integer",
            "title": "Score",
            "default": 0
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "descendants": {
            "type": "integer",
            "title": "Descendants",
            "default": 0
          },
          "kids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Kids"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "Story"
      },
      "Summary": {
        "properties": {
          "story_id": {
            "type": "integer",
            "title": "Story Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "comment_count": {
            "type": "integer",
            "title": "Comment Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "story_id",
          "status"
        ],
        "title": "Summary"
      },
      "SummaryJob": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "story_id": {
            "type": "integer",
            "title": "Story Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "story_id"
        ],
        "title": "SummaryJob"
      },
      "SummaryRequest": {
        "properties": {
          "story_id": {
            "type": "integer",
            "title": "Story Id"
          }
        },
        "type": "object",
        "required": [
          "story_id"
        ],
        "title": "SummaryRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}